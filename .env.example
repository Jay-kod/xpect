# -----------------------------------------------------------------------------
# XPECT - Local Football Prediction Engine Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and configure your local keys before running:
#   php artisan key:generate
#   touch database/database.sqlite
#   php artisan migrate --seed
#   php artisan serve --port=8080
# -----------------------------------------------------------------------------

# --- Application Core ---
APP_NAME=Xpect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8080
SERVER_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging & Diagnostics ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Local SQLite default) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# --- Sessions & State ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache, Queue & Filesystem ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

# --- Football Data API Providers ---
# 1. football-data.org (Free Tier: 10 req/min, PL + Big 5 coverage)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# 2. API-Football / RapidAPI (Lineups, squad rosters, player stats)
API_FOOTBALL_KEY=your_api_football_key_here

# --- Anthropic Claude API (AI Previews & Match Reasoning) ---
# Used exclusively via LoggedHttpClient for plain-language structured explanations.
# The LLM explains computed probabilities; it never decides predictions.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Feature & Model Hyperparameters (Defaults match active v1.2.1-h2h) ---
FOOTBALL_WINDOW_MATCHES=20
FOOTBALL_HALF_LIFE_DAYS=60
FOOTBALL_SHRINKAGE_K=3.0
DIXON_COLES_RHO=-0.06
